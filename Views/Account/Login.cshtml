@{
    ViewData["Title"] = "دخول";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="border: 2px solid #e94560;">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4" style="color: #e94560;">
                        🔐 تسجيل الدخول
                    </h2>

                    <form asp-action="Login" method="post" asp-antiforgery="true">
                        <div class="form-group mb-3">
                            <label for="Email" class="form-label" style="color: #e0e0e0;">البريد الإلكتروني</label>
                            <input type="email" class="form-control" id="Email" name="Email" required autofocus style="background: #16213e; border-color: #e94560; color: #e0e0e0;">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="Password" class="form-label" style="color: #e0e0e0;">كلمة المرور</label>
                            <input type="password" class="form-control" id="Password" name="Password" required style="background: #16213e; border-color: #e94560; color: #e0e0e0;">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="RememberMe" name="RememberMe" style="background: #16213e; border-color: #e94560;">
                            <label class="form-check-label" for="RememberMe" style="color: #a0a0a0;">
                                تذكر بيانات دخولي
                            </label>
                        </div>

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.ErrorMessage
                            </div>
                        }

                        <button type="submit" class="btn w-100" style="background-color: #e94560; color: white; font-weight: bold; padding: 10px;">
                            🔐 دخول
                        </button>
                    </form>

                    <hr style="border-color: #e94560;">

                    <p class="text-center" style="color: #a0a0a0;">
                        ليس لديك حساب؟
                        <a asp-controller="Account" asp-action="Register" style="color: #00d4ff; text-decoration: none;">
                            إنشاء حساب جديد
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
