@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="container-fluid">
    <h1 class="mb-4" style="color: #e94560;">📊 لوحة التحكم</h1>

    <!-- Statistics Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center" style="background: rgba(233, 69, 96, 0.1); border-color: #e94560;">
                <div class="card-body">
                    <h5 style="color: #00d4ff;">🎯 إجمالي التهديدات</h5>
                    <h2 style="color: #e94560; font-weight: bold;">@Model.TotalThreats</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: rgba(255, 0, 0, 0.1); border-color: #ff6b6b;">
                <div class="card-body">
                    <h5 style="color: #ff6b6b;">🚨 تهديدات حرجة</h5>
                    <h2 style="color: #ff6b6b; font-weight: bold;">@Model.CriticalThreats</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: rgba(0, 212, 255, 0.1); border-color: #00d4ff;">
                <div class="card-body">
                    <h5 style="color: #00d4ff;">📈 المراقبة</h5>
                    <h2 style="color: #00d4ff; font-weight: bold;">✓ نشطة</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center" style="background: rgba(255, 165, 2, 0.1); border-color: #ffa502;">
                <div class="card-body">
                    <h5 style="color: #ffa502;">⏱️ آخر فحص</h5>
                    <h2 style="color: #ffa502; font-weight: bold;">الآن</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Threats -->
    <div class="row">
        <div class="col-md-8">
            <div class="card" style="border-color: #e94560;">
                <div class="card-header" style="border-bottom: 2px solid #e94560; color: #e94560;">
                    <h5 class="mb-0">🔔 آخر التهديدات</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentThreats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark">
                                <thead style="border-bottom: 2px solid #e94560;">
                                    <tr>
                                        <th style="color: #e94560;">نوع التهديد</th>
                                        <th style="color: #e94560;">الخطورة</th>
                                        <th style="color: #e94560;">IP المصدر</th>
                                        <th style="color: #e94560;">التاريخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var threat in Model.RecentThreats)
                                    {
                                        <tr>
                                            <td>@threat.ThreatType</td>
                                            <td>
                                                <span class="badge" style="background-color: @GetSeverityColor(threat.Severity);">@threat.Severity</span>
                                            </td>
                                            <td>@threat.SourceIP</td>
                                            <td>@threat.DetectedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Dashboard" asp-action="Threats" class="btn" style="background-color: #e94560; color: white;">
                            عرض جميع التهديدات
                        </a>
                    }
                    else
                    {
                        <p style="color: #a0a0a0; text-align: center;">✅ لا توجد تهديدات حتى الآن</p>
                    }
                </div>
            </div>
        </div>

        <!-- Statistics Chart -->
        <div class="col-md-4">
            <div class="card" style="border-color: #00d4ff;">
                <div class="card-header" style="border-bottom: 2px solid #00d4ff; color: #00d4ff;">
                    <h5 class="mb-0">📊 إحصائيات التهديدات</h5>
                </div>
                <div class="card-body">
                    @if (Model.ThreatStatistics.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var stat in Model.ThreatStatistics.Take(5))
                            {
                                <li class="mb-3">
                                    <div style="display: flex; justify-content: space-between; color: #e0e0e0;">
                                        <span>@stat.Key</span>
                                        <span style="color: #e94560; font-weight: bold;">@stat.Value</span>
                                    </div>
                                    <div class="progress" style="height: 8px; background: #16213e;">
                                        <div class="progress-bar" role="progressbar" style="width: @(stat.Value * 5)%; background-color: #e94560;"></div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p style="color: #a0a0a0; text-align: center;">لا توجد إحصائيات بعد</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetSeverityColor(CyberInsight.Models.ThreatSeverity severity)
    {
        return severity switch
        {
            CyberInsight.Models.ThreatSeverity.Low => "#00d4ff",
            CyberInsight.Models.ThreatSeverity.Medium => "#ffa502",
            CyberInsight.Models.ThreatSeverity.High => "#e94560",
            CyberInsight.Models.ThreatSeverity.Critical => "#ff0000",
            _ => "#a0a0a0"
        };
    }
}
