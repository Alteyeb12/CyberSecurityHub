@{
    ViewData["Title"] = "التهديدات";
}

<div class="container-fluid">
    <h1 class="mb-4" style="color: #e94560;">📋 جميع التهديدات</h1>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped">
                <thead style="border-bottom: 2px solid #e94560;">
                    <tr>
                        <th style="color: #e94560;">#</th>
                        <th style="color: #e94560;">نوع التهديد</th>
                        <th style="color: #e94560;">الوصف</th>
                        <th style="color: #e94560;">الخطورة</th>
                        <th style="color: #e94560;">IP المصدر</th>
                        <th style="color: #e94560;">التاريخ</th>
                        <th style="color: #e94560;">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var threat in Model)
                    {
                        <tr>
                            <td>@threat.Id</td>
                            <td>@threat.ThreatType</td>
                            <td>@threat.Description</td>
                            <td>
                                <span class="badge" style="background-color: @GetSeverityColor(threat.Severity);">
                                    @threat.Severity
                                </span>
                            </td>
                            <td>@threat.SourceIP</td>
                            <td>@threat.DetectedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (threat.IsResolved)
                                {
                                    <span class="badge" style="background-color: #00d4ff;">✓ محلول</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #e94560;">⚠ نشط</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" style="background: rgba(0, 212, 255, 0.1); border-color: #00d4ff; color: #e0e0e0;">
            <p style="text-align: center;">✅ لا توجد تهديدات حتى الآن</p>
        </div>
    }
</div>

@functions {
    string GetSeverityColor(CyberInsight.Models.ThreatSeverity severity)
    {
        return severity switch
        {
            CyberInsight.Models.ThreatSeverity.Low => "#00d4ff",
            CyberInsight.Models.ThreatSeverity.Medium => "#ffa502",
            CyberInsight.Models.ThreatSeverity.High => "#e94560",
            CyberInsight.Models.ThreatSeverity.Critical => "#ff0000",
            _ => "#a0a0a0"
        };
    }
}
